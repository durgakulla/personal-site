---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

/**
 * Add your photos here. Each entry maps to a file in /public/images/portfolio/.
 * aspect options: 'square' | 'portrait' | 'landscape' | 'wide'
 */
const photos = [
  { src: '/images/portfolio/photo-01.jpg', alt: 'Photo 1', aspect: 'landscape' },
  { src: '/images/portfolio/photo-02.jpg', alt: 'Photo 2', aspect: 'portrait' },
  { src: '/images/portfolio/photo-03.jpg', alt: 'Photo 3', aspect: 'square' },
  { src: '/images/portfolio/photo-04.jpg', alt: 'Photo 4', aspect: 'portrait' },
  { src: '/images/portfolio/photo-05.jpg', alt: 'Photo 5', aspect: 'landscape' },
  { src: '/images/portfolio/photo-06.jpg', alt: 'Photo 6', aspect: 'square' },
  { src: '/images/portfolio/photo-07.jpg', alt: 'Photo 7', aspect: 'landscape' },
  { src: '/images/portfolio/photo-08.jpg', alt: 'Photo 8', aspect: 'portrait' },
  { src: '/images/portfolio/photo-09.jpg', alt: 'Photo 9', aspect: 'square' },
  { src: '/images/portfolio/photo-10.jpg', alt: 'Photo 10', aspect: 'landscape' },
  { src: '/images/portfolio/photo-11.jpg', alt: 'Photo 11', aspect: 'portrait' },
  { src: '/images/portfolio/photo-12.jpg', alt: 'Photo 12', aspect: 'square' },
];

const aspectClasses: Record<string, string> = {
  square: 'aspect-square',
  portrait: 'aspect-[2/3]',
  landscape: 'aspect-[4/3]',
  wide: 'aspect-[16/9]',
};
---

<Layout title="Durga Kullakanda — Photography">
  <Nav />

  <main class="flex-1 px-6 md:px-8 pb-16">
    <div class="text-center mb-10">
      <p class="text-xs tracking-[0.3em] uppercase text-stone-400">Portfolio</p>
    </div>

    <div class="masonry">
      {
        photos.map((photo) => (
          <div class="masonry-item group cursor-pointer overflow-hidden">
            <div class={`w-full bg-stone-100 overflow-hidden ${aspectClasses[photo.aspect] ?? 'aspect-square'}`}>
              <img
                src={photo.src}
                alt={photo.alt}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
          </div>
        ))
      }
    </div>
  </main>

  <Footer />
</Layout>
