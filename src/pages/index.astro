---
import Layout from '../layouts/Layout.astro';
import { getAlbumSlugs, getAlbumCover, getAlbumInfo } from '../lib/albums';
import about from '../data/about.json';

const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

// Album index uses a forced, evenly-cropped grid (unlike the true masonry on
// album pages) — with only a handful of albums, uneven heights from varying
// cover aspect ratios look like gaps rather than intentional variety.
// Grid shows 1 column below 1000px, 2 columns above.
const SIZES = '(min-width: 1000px) 48vw, 100vw';

const albums = getAlbumSlugs().map(slug => {
  const { name, month, year } = getAlbumInfo(slug);
  const dateParts = [month ? MONTHS[month - 1] : null, year ?? null].filter(Boolean);
  return { slug, name, cover: getAlbumCover(slug), date: dateParts.length ? dateParts.join(' · ') : null };
}).filter(album => album.cover);
---

<Layout title={`${about.name} — Photography`}>
  <div class="px-6 md:px-8 py-10">
    {about.tagline && (
      <p class="text-stone-800 dark:text-stone-100 font-medium text-base md:text-lg leading-relaxed mb-3">
        {about.tagline}
      </p>
    )}
    <div class="index-grid">
      {albums.map(album => (
        <a
          href={`/albums/${album.slug}`}
          class="index-grid-item group block overflow-hidden relative aspect-[4/3]"
        >
          {album.cover && (
            <img
              src={album.cover.src}
              srcset={album.cover.srcset}
              sizes={SIZES}
              alt={album.cover.alt}
              class="w-full h-full object-cover block transition-transform duration-500 ease-out group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
          )}
          <div class="absolute inset-0 bg-black/35 group-hover:bg-black/50 transition-colors duration-300 flex flex-col items-center justify-center text-center px-4">
            <p class="text-white font-extrabold uppercase tracking-tight leading-[0.88] text-balance break-words max-w-full text-[8vw] md:text-[3.5vw] lg:text-[2.8vw]">
              {album.name}
            </p>
            {album.date && (
              <p class="text-white/80 font-semibold text-sm md:text-base tracking-[0.3em] uppercase mt-3 md:mt-4">
                {album.date}
              </p>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  .index-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }
  @media (min-width: 1000px) {
    .index-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
