---
import '../styles/global.css';
import { getAlbumsMeta } from '../lib/albums';
import type { Photo } from '../lib/albums';
import { socialIcons } from '../lib/socialIcons';
import socials from '../data/socials.json';
import about from '../data/about.json';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  activeAlbum?: string;
  activePage?: string;
  /** First image on the page, if it's above the fold — preloaded as the LCP candidate. */
  lcpImage?: { photo: Photo; sizes: string };
}

const {
  title = about.name,
  description = `Personal website of ${about.name} — photography, projects, and more`,
  ogImage = '/images/profile.jpg',
  activeAlbum,
  activePage,
  lcpImage,
} = Astro.props;

// The LCP image is already loading="eager" fetchpriority="high", but the parser
// has to reach it first; preloading starts the fetch while <head> is still being
// read. Only the best format is preloaded, never one per format: `type` makes a
// browser skip a preload it can't decode, but one that supports both AVIF and
// WebP would honour both links and fetch the photo twice. A browser without AVIF
// simply ignores this and discovers its WebP the usual way — no worse than now.
const lcpSource = lcpImage?.photo.sources[0];

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL   = new URL(ogImage, Astro.site);

const albums = getAlbumsMeta();

function isActive(href: string) {
  if (href === '/') return Astro.url.pathname === '/' || Astro.url.pathname.startsWith('/albums');
  return Astro.url.pathname === href || Astro.url.pathname.startsWith(href + '/');
}

// The local admin editor (npm run admin), linked from a pill that only exists
// while `astro dev` is running. import.meta.env.DEV is resolved at build time,
// so the hosted site carries no markup for it at all — not even hidden.
// The album segment is passed through exactly as the URL spells it: encoded or
// not, the admin decodes its own pathname, and the browser encodes an href.
const adminPath = Astro.url.pathname.replace(/\/$/, '');
const adminAlbum = adminPath.match(/^\/albums\/(.+)$/);
const adminHref = 'http://localhost:4001' + (
  adminAlbum                  ? `/album/${adminAlbum[1]}` :
  adminPath === '/about'      ? '/about' :
  adminPath === '/projects'   ? '/projects' : '/'
);

const logoColors = ['#c2542f', '#d9a441', '#2f6f6a', '#7a8b4f', '#a8433a', '#c9a066'];

const [logoFirstLine, ...logoRestWords] = about.name.split(' ');
const logoSecondLine = logoRestWords.join(' ');

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": about.name,
      "url": Astro.site,
      "image": ogImageURL,
      "sameAs": socials.filter(s => !s.href.startsWith('mailto')).map(s => s.href),
    })} />

    <!-- Barlow is self-hosted (see src/styles/global.css); no third-party
         connection sits on the critical path any more. These two weights are
         on every page above the fold — the wordmark at 800, the nav at 700 —
         so start them before the CSS that references them has parsed. -->
    <link rel="preload" href="/fonts/barlow-800-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-700-latin.woff2" as="font" type="font/woff2" crossorigin />

    {lcpSource && (
      <link
        rel="preload"
        as="image"
        type={lcpSource.type}
        imagesrcset={lcpSource.srcset}
        imagesizes={lcpImage!.sizes}
        fetchpriority="high"
      />
    )}
    <!-- Apply theme before paint to prevent flash. Dark is the default; only an
         explicit "light" choice opts out. The choice is mirrored into a cookie,
         which (unlike localStorage) is shared across ports on the same host, so
         the local admin at :4001 and the dev site at :4321 stay in sync. -->
    <script is:inline>
      (() => {
        // Flags that scripting is live, which is what gates the JS-driven image
        // fade-in in global.css — without it images would never become visible.
        document.documentElement.classList.add('js');
        const c = document.cookie.match(/(?:^|;\s*)theme=(dark|light)/);
        const pref = c ? c[1] : localStorage.getItem('theme');
        document.documentElement.classList.toggle('dark', pref !== 'light');
      })();
    </script>
  </head>
  <body class="flex max-w-[1300px] mx-auto bg-white dark:bg-stone-950 text-stone-900 dark:text-stone-100">

    <!-- ── Desktop sidebar ── -->
    <aside class="hidden md:flex sticky top-0 self-start h-screen shrink-0 w-48 lg:w-56 xl:w-64 2xl:w-72 flex-col items-start px-8 py-10 overflow-y-auto z-40 bg-white dark:bg-stone-950">
      <a href="/" aria-label={about.name} class="hover:opacity-80 transition-opacity mb-10 inline-block text-center self-center">
        <span class="font-extrabold text-3xl tracking-tight leading-none uppercase text-stone-900 dark:text-stone-100 block">
          {logoFirstLine}{logoSecondLine && <><br/>{logoSecondLine}</>}
        </span>
        <div class="flex h-1.5 mt-1.5">
          {logoColors.map(c => <span class="flex-1" style={`background:${c}`}></span>)}
        </div>
      </a>

      <div class="flex flex-col items-start gap-6 mb-10">
        <a href="/about"    class={`font-bold text-base tracking-widest uppercase transition-colors ${isActive('/about')    ? 'text-stone-900 dark:text-stone-100' : 'text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100'}`}>About</a>
        <a href="/projects" class={`font-bold text-base tracking-widest uppercase transition-colors ${isActive('/projects') ? 'text-stone-900 dark:text-stone-100' : 'text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100'}`}>Projects</a>
      </div>

      <div class="flex flex-col items-start text-left">
        <a href="/" class={`font-bold text-base tracking-widest uppercase transition-colors block mb-4 ${isActive('/') ? 'text-stone-900 dark:text-stone-100' : 'text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100'}`}>Albums</a>
        <nav class="flex flex-col items-start gap-2">
          {albums.map(({ slug, name }) => (
            <a
              href={`/albums/${slug}`}
              class={`text-base py-0.5 transition-colors ${activeAlbum === slug || isActive(`/albums/${slug}`) ? 'font-bold text-stone-900 dark:text-stone-100' : 'text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-200'}`}
            >
              {name}
            </a>
          ))}
        </nav>
      </div>

      <div class="mt-auto pt-10 flex flex-col items-start gap-4">
        <!-- Theme toggle -->
        <button id="theme-toggle-desktop" aria-label="Toggle theme" class="flex items-center gap-2 text-stone-400 dark:text-stone-500 hover:text-stone-700 dark:hover:text-stone-300 transition-colors text-xs">
          <!-- Moon: visible in light mode -->
          <svg class="block dark:hidden w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
          <!-- Sun: visible in dark mode -->
          <svg class="hidden dark:block w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <span class="dark:hidden">Dark</span>
          <span class="hidden dark:inline">Light</span>
        </button>

        <!-- Social icons -->
        <div class="flex flex-wrap gap-x-4 gap-y-3 max-w-full">
          {socials.map(({ label, href }) => (
            <a href={href} target={href.startsWith('mailto') ? undefined : '_blank'} rel="noopener noreferrer" aria-label={label} class="text-stone-400 dark:text-stone-500 hover:text-stone-700 dark:hover:text-stone-300 transition-colors [&>svg]:w-4 [&>svg]:h-4" set:html={socialIcons[label] ?? socialIcons.Misc} />
          ))}
        </div>

        <p class="text-[10px] text-stone-300 dark:text-stone-700">
          &copy; {new Date().getFullYear()} {about.name}
        </p>

        {import.meta.env.DEV && <div class="h-12 shrink-0" aria-hidden="true"></div>}
      </div>
    </aside>

    <!-- ── Main content ── -->
    <div class="flex-1 min-h-screen flex flex-col">
      <!-- Mobile header bar -->
      <div class="md:hidden flex items-center justify-between px-5 py-4 border-b border-stone-100 dark:border-stone-800">
        <a href="/" aria-label={about.name} class="inline-block">
          <span class="font-extrabold text-xl tracking-tight uppercase text-stone-900 dark:text-stone-100 block">{about.name}</span>
          <div class="flex h-1 mt-1">
            {logoColors.map(c => <span class="flex-1" style={`background:${c}`}></span>)}
          </div>
        </a>
        <button id="theme-toggle-header" aria-label="Toggle theme" class="text-stone-400 dark:text-stone-500 hover:text-stone-700 dark:hover:text-stone-300 transition-colors">
          <svg class="block dark:hidden w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <svg class="hidden dark:block w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </button>
      </div>

      <main class="flex-1">
        {!activeAlbum && (
          <div class="md:hidden">
            <nav class="flex items-center justify-center gap-8 px-6 pt-6 pb-2 font-extrabold text-2xl tracking-tight">
              <a href="/about" class={isActive('/about') ? 'text-stone-900 dark:text-stone-100' : 'text-stone-300 dark:text-stone-600 hover:text-stone-900 dark:hover:text-stone-100 transition-colors'}>About</a>
              <a href="/projects" class={isActive('/projects') ? 'text-stone-900 dark:text-stone-100' : 'text-stone-300 dark:text-stone-600 hover:text-stone-900 dark:hover:text-stone-100 transition-colors'}>Projects</a>
              {isActive('/') ? (
                <button id="albums-toggle" class="text-stone-900 dark:text-stone-100 flex items-center gap-1">
                  Albums
                  <svg id="albums-arrow" xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-stone-400 dark:text-stone-500 transition-transform duration-200 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
              ) : (
                <a href="/" class="text-stone-300 dark:text-stone-600 hover:text-stone-900 dark:hover:text-stone-100 transition-colors">Albums</a>
              )}
            </nav>
            <div id="albums-dropdown" class="hidden flex-col items-center gap-2 pb-4 pt-2">
              {albums.map(({ slug, name }) => (
                <a href={`/albums/${slug}`} class="text-base text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-colors">{name}</a>
              ))}
            </div>
          </div>
        )}
        <slot />
      </main>
    </div>

    <!-- Dev only. z-40 sits above the sticky sidebar (also z-40, but earlier in
         the document) and below the lightbox at z-50, which should cover it. -->
    {import.meta.env.DEV && (
      <a
        id="admin-pill"
        href={adminHref}
        class="fixed bottom-4 left-4 z-40 flex items-center gap-2 rounded-full border border-stone-200 dark:border-stone-700 bg-white/90 dark:bg-stone-900/90 backdrop-blur px-3.5 py-2 text-xs font-semibold text-stone-500 dark:text-stone-400 shadow-sm hover:text-stone-900 dark:hover:text-stone-100 hover:border-stone-300 dark:hover:border-stone-600 transition-colors"
      >
        <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/>
        </svg>
        Admin
      </a>
    )}

  </body>
</html>

<script>
  // ── Albums dropdown ──────────────────────────────────────────────────────────
  const albumsToggle   = document.getElementById('albums-toggle');
  const albumsDropdown = document.getElementById('albums-dropdown');
  albumsToggle?.addEventListener('click', () => {
    albumsDropdown?.classList.toggle('hidden');
    albumsDropdown?.classList.toggle('flex');
    document.getElementById('albums-arrow')?.classList.toggle('rotate-180');
  });

  // ── Live reload from the admin (dev only) ────────────────────────────────────
  // The admin pushes an event whenever it writes content, and the dev server
  // re-reads from disk on every request — so a reload is all it takes to show
  // an edit made in the other window. import.meta.env.DEV is a build-time
  // constant, so none of this reaches the built site.
  if (import.meta.env.DEV) {
    const adminPill = document.getElementById('admin-pill');
    let source: EventSource | null = null;
    let retry = 0;

    const connect = () => {
      source?.close();
      source = new EventSource('http://localhost:4001/api/events');

      source.onopen = () => {
        retry = 0;
        adminPill?.classList.remove('opacity-40');
        if (adminPill) adminPill.title = '';
      };

      source.addEventListener('content', () => location.reload());

      source.onerror = () => {
        // The admin isn't running (or just stopped). EventSource would retry
        // forever on its own and fill the console doing it, so back off here
        // instead, and say so on the pill rather than leaving a dead link.
        source?.close();
        adminPill?.classList.add('opacity-40');
        if (adminPill) adminPill.title = 'Not running — start it with: npm run admin';
        setTimeout(connect, Math.min(1000 * 2 ** retry++, 30000));
      };
    };

    connect();
    // Coming back to the tab is the moment to stop waiting out a long backoff.
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && source?.readyState !== EventSource.OPEN) connect();
    });
  }

  // ── Image fade-in ────────────────────────────────────────────────────────────
  document.querySelectorAll('img').forEach(img => {
    if (img.complete) img.classList.add('loaded');
    else img.addEventListener('load', () => img.classList.add('loaded'), { once: true });
  });

  // ── Theme toggle ──────────────────────────────────────────────────────────────
  // Written to a cookie as well as localStorage so the local admin — a
  // different port, and so a different localStorage — sees the same choice.
  // Only on localhost: in production there's no admin to sync with.
  const themeSynced = location.hostname === 'localhost' || location.hostname === '127.0.0.1';

  function readThemePref() {
    const c = document.cookie.match(/(?:^|;\s*)theme=(dark|light)/);
    return c ? c[1] : localStorage.getItem('theme');
  }

  function toggleTheme() {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
    if (themeSynced) document.cookie = 'theme=' + (dark ? 'dark' : 'light') + ';path=/;max-age=31536000;SameSite=Lax';
  }

  document.getElementById('theme-toggle-desktop')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-header')?.addEventListener('click', toggleTheme);

  // Cookie changes fire no event, so re-read the shared preference whenever
  // this tab comes back to the foreground: toggling in the admin and switching
  // back here applies the change without a reload.
  document.addEventListener('visibilitychange', () => {
    if (document.hidden || !themeSynced) return;
    document.documentElement.classList.toggle('dark', readThemePref() !== 'light');
  });
</script>
